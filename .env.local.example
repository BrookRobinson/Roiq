# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to browser

# ── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ───────────────────────────────────────────────────────────────────
# The prices MUST be one-off ("One time"), not recurring. The landing page,
# pricing page and FAQ all promise nothing auto-renews, and a recurring price
# would quietly make that false. /api/health/billing checks for this.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`, or the
# endpoint's signing secret in the dashboard. Without it nothing grants a plan:
# checkout succeeds and the buyer stays on Free.
STRIPE_WEBHOOK_SECRET=whsec_...
# Unused — checkout runs on Stripe's hosted page, so the browser never needs a
# Stripe key. Kept because it's harmless and people look for it.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_STARTER_PRICE_ID=price_...   # NZ$49, one-off
STRIPE_PRO_PRICE_ID=price_...       # NZ$99, one-off

# ── Scraping ─────────────────────────────────────────────────────────────────
SCRAPER_API_KEY=

# ── Mapbox ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
